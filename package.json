{
	"name": "obsidian-archivist",
	"version": "0.1.0",
	"description": "Your vault's quiet historian. Versioned vault backups to Dropbox with content-addressed storage, hierarchical retention, and file-level restore.",
	"main": "main.js",
	"author": "Marcus Breiden",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/MMoMM-org/obsidian-archivist"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs --dev",
		"build": "tsc --noEmit && node esbuild.config.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint src/ --ext .ts",
		"typecheck": "tsc --noEmit",
		"audit": "npm audit --audit-level=high"
	},
	"keywords": ["obsidian", "obsidian-plugin", "backup", "dropbox", "versioning"],
	"devDependencies": {
		"@typescript-eslint/parser": "7.18.0",
		"@types/node": "22.0.0",
		"@vitest/coverage-v8": "2.1.9",
		"dropbox": "10.34.0",
		"esbuild": "0.24.0",
		"eslint": "8.57.1",
		"eslint-plugin-local": "file:./tools/eslint",
		"eslint-plugin-obsidianmd": "0.1.9",
		"obsidian": "1.5.0",
		"typescript": "5.6.3",
		"vitest": "2.1.9"
	}
}
