{
	"name": "obsidian-archivist",
	"version": "0.1.0",
	"description": "Your vault's quiet historian. Versioned vault backups to Dropbox with content-addressed storage, hierarchical retention, and file-level restore.",
	"main": "main.js",
	"author": "Marcus Breiden",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/MMoMM-org/obsidian-archivist"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs --dev",
		"build": "tsc --noEmit && node esbuild.config.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint src/",
		"typecheck": "tsc --noEmit",
		"audit": "npm audit --audit-level=high"
	},
	"keywords": ["obsidian", "obsidian-plugin", "backup", "dropbox", "versioning"],
	"dependencies": {
		"dropbox": "10.34.0"
	},
	"devDependencies": {
		"@eslint/js": "9.39.4",
		"@types/node": "22.19.17",
		"@vitest/coverage-v8": "4.1.5",
		"esbuild": "0.28.0",
		"eslint": "9.39.4",
		"eslint-plugin-local": "file:./tools/eslint",
		"eslint-plugin-obsidianmd": "0.2.4",
		"obsidian": "1.8.7",
		"typescript": "6.0.3",
		"typescript-eslint": "8.59.0",
		"vitest": "4.1.5"
	}
}
